{
  "manifest_version": 3,
  "name": "随页汇率",
  "version": "1.0.0",
  "description": "识别网页金额，在原价旁显示目标货币的参考金额。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://open.er-api.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "money.js",
        "content.js"
      ],
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "随页汇率"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
